# Supply-chain hardening. See https://docs.npmjs.com/cli/v11/configuring-npm/npmrc

# Require a 2-day (≈48h) cooldown before installing any newly-published
# version. Most supply-chain compromises are detected and yanked within hours;
# this window keeps us out of the blast radius.
# Requires npm >= 11.10 (the option was added in npm/cli#8965).
# Note: npm's `min-release-age` is measured in DAYS. Do not confuse with
# pnpm's `minimumReleaseAge`, which is in minutes.
min-release-age=2

# Skip pre/post/install lifecycle scripts. Our only deps with install scripts
# are esbuild (binary verification, harmless to skip — platform binary comes
# from optional dep) and fsevents (prebuilt .node binary, chokidar falls back
# to polling if skipped). If we add a dep that needs to build native code
# (sharp, bcrypt, better-sqlite3, prisma, puppeteer/playwright browsers, etc.)
# either drop this flag or run the build step explicitly.
ignore-scripts=true

# `npm install <pkg>` saves the exact version, not ^x.y.z.
save-exact=true

# Quieter installs, stricter audit gate.
fund=false
audit-level=high
