FROM node:22-alpine AS builder

WORKDIR /src

# node:22-alpine ships with npm 10.x, but web/.npmrc uses `minimum-release-age`
# (added in npm 11.5). Without this upgrade, npm warns and silently ignores the
# supply-chain cooldown. Pinned (not @latest) to keep image builds reproducible
# and to apply our own supply-chain cooldown to npm itself — bump intentionally.
# This ARG is the single source of truth; CI extracts it via grep.
ARG NPM_VERSION=11.15.0
RUN npm install -g npm@${NPM_VERSION}

COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ .
RUN npm run build

FROM nginx:alpine

COPY --from=builder /src/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
